{
  "name": "instui-markdown",
  "version": "0.0.8",
  "description": "InstUI markdown renderer components",
  "license": "MIT",
  "files": [
    "dist",
    "index.d.mts",
    "index.d.ts"
  ],
  "type": "module",
  "types": "./index.d.mts",
  "exports": {
    ".": {
      "types": "./index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "rehype-instui-markdown": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "*",
    "@types/react-dom": "*",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@instructure/ui-alerts": "*",
    "@instructure/ui-badge": "*",
    "@instructure/ui-checkbox": "*",
    "@instructure/ui-color-utils": "*",
    "@instructure/ui-heading": "*",
    "@instructure/ui-icons": "*",
    "@instructure/ui-img": "*",
    "@instructure/ui-link": "*",
    "@instructure/ui-list": "*",
    "@instructure/ui-source-code-editor": "*",
    "@instructure/ui-svg-images": "*",
    "@instructure/ui-table": "*",
    "@instructure/ui-text": "*",
    "@instructure/ui-view": "*",
    "@mdx-js/react": "*",
    "react": "*",
    "react-markdown": "*",
    "rehype-autolink-headings": "*",
    "rehype-raw": "*",
    "rehype-slug": "*",
    "remark-gfm": "*"
  }
}
